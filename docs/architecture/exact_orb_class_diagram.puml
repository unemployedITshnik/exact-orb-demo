  }

  abstract class DataSelector <<ABC>> {
    +select(plan: InterpretationPlan, tool_results: list[ToolResult]): dict[str, Any]
  }

  abstract class PromptBuilder <<ABC>> {
    +build(plan: InterpretationPlan, evidence: dict[str, Any]): PromptBundle
  }

  class PromptRegistry {
    -_recipes: dict[str, Any]
    +register(recipe_id: str, recipe: Any): None
    +get(recipe_id: str): Any
  }

  class UnknownPromptRecipeError <<Exception>>
  class DuplicatePromptRecipeError <<Exception>>
  class InvalidPromptRecipeError <<Exception>>
}

package "exact_orb.orchestration" as orchestration {
  class OrchestrationResponse <<Pydantic>> {
