    +run(request: ToolRequest): ToolResult
  }

  class NatalToolArgs <<Pydantic>> {
    +birth_datetime: datetime
    +latitude: float
    +longitude: float
    +chart_kind: ChartKind
    +house_system: str
    +rulership: str
    +include: tuple[str]
  }

  class NatalTool {
    +name: str
    +run(request: ToolRequest): ToolResult
  }

  class ToolRegistry {
    -_tools: dict[str, Tool]
    +default(): ToolRegistry
    +register(tool: Tool): None
    +get(name: str): Tool
    +list_tools(): list[str]
  }

  class UnknownToolError <<Exception>>
  class DuplicateToolError <<Exception>>
  class InvalidToolError <<Exception>>
}

package "exact_orb.interpretation" as interpretation {
  class PromptBundle <<Pydantic>> {
