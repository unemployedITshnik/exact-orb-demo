@startuml
title exact-orb — каноническая блок-схема модулей MVP

top to bottom direction

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam DefaultFontSize 12
skinparam ArrowFontSize 10
skinparam nodesep 30
skinparam ranksep 42

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    FontColor #1E293B
}

skinparam component {
    BorderColor #64748B
    FontColor #0F172A
}

skinparam database {
    BorderColor #15803D
    FontColor #0F172A
}

actor "Пользователь" as User


package "1. CLIENT" as Client {

    component "<b><color:#172033>Frontend</color></b>\n<color:#526071>Клиентское состояние\nи управление экранами</color>" as Frontend #DBEAFE

    component "<b><color:#172033>Birth Form</color></b>\n<color:#526071>Явный ввод и изменение\nданных рождения</color>" as BirthForm #DBEAFE

    component "<b><color:#172033>Chart Controls</color></b>\n<color:#526071>Build derived chart,\nSet active view, topic + focus</color>" as Controls #DBEAFE

    component "<b><color:#172033>Location Dropdown</color></b>\n<color:#526071>Подсказки и выбор\ncanonical place_id</color>" as LocationUI #DBEAFE

    component "<b><color:#172033>Chart Renderer</color></b>\n<color:#526071>Chart DTO → SVG-карта</color>" as Renderer #DBEAFE

    Frontend -[#94A3B8]-> BirthForm
    Frontend -[#94A3B8]-> Controls
    Frontend -[#94A3B8]-> LocationUI
    Frontend -[#94A3B8]-> Renderer
}


package "2. API LAYER" as ApiLayer {

    component "<b><color:#172033>FastAPI</color></b>\n<color:#526071>Транспорт, DTO validation,\nJSON и SSE</color>" as API #EDE9FE

    component "<b><color:#172033>Session Middleware</color></b>\n<color:#526071>Устойчивая HttpOnly cookie\n→ anonymous session_id</color>" as SessionMiddleware #EDE9FE

    component "<b><color:#172033>Build Natal API</color></b>\n<color:#526071>Явное создание или замена\nбазовой карты</color>" as BuildNatalAPI #EDE9FE

    component "<b><color:#172033>Build Derived API</color></b>\n<color:#526071>Явное создание или замена\nтранзита / соляра</color>" as BuildDerivedAPI #EDE9FE

    component "<b><color:#172033>Set Active View API</color></b>\n<color:#526071>Переключение base / derived\nбез нового расчёта</color>" as SetViewAPI #EDE9FE

    component "<b><color:#172033>Selection API</color></b>\n<color:#526071>Preset-интерпретация\nпо topic + focus</color>" as SelectionAPI #EDE9FE

    API -[#94A3B8]-> SessionMiddleware
    API -[#94A3B8]-> BuildNatalAPI
    API -[#94A3B8]-> BuildDerivedAPI
    API -[#94A3B8]-> SetViewAPI
    API -[#94A3B8]-> SelectionAPI
}


package "3. APPLICATION COORDINATION" as Application {

    component "<b><color:#172033>Orchestrator</color></b>\n<color:#526071>Единая точка координации,\nrun_id и StreamEvent</color>" as Orch #FFEDD5

    component "<b><color:#172033>BuildNatalHandler</color></b>\n<color:#526071>Resolve → calculate →\ncommit base chart</color>" as BuildNatalHandler #FFEDD5

    component "<b><color:#172033>BuildDerivedChartHandler</color></b>\n<color:#526071>Validate → calculate →\ncommit derived chart</color>" as BuildDerivedHandler #FFEDD5

    component "<b><color:#172033>SetActiveViewHandler</color></b>\n<color:#526071>Явная мутация active_view\nбез расчёта</color>" as SetViewHandler #FFEDD5

    component "<b><color:#172033>InterpretSelectionHandler</color></b>\n<color:#526071>Подготовка preset-запроса;\nSessionProfile только читается</color>" as SelectionHandler #FFEDD5

    Orch -[#94A3B8]-> BuildNatalHandler
    Orch -[#94A3B8]-> BuildDerivedHandler
    Orch -[#94A3B8]-> SetViewHandler
    Orch -[#94A3B8]-> SelectionHandler
}


package "4. SESSION STATE" as State {

    component "<b><color:#172033>ContextService</color></b>\n<color:#526071>load / save состояния\nанонимной сессии</color>" as Context #D1FAE5

    component "<b><color:#172033>ProfileService</color></b>\n<color:#526071>Чистые типизированные мутации\nSessionProfile; без persistence</color>" as Profile #D1FAE5

    database "<b><color:#172033>Session Store</color></b>\n<color:#526071>SessionProfile + последние ходы;\nограниченный TTL</color>" as SessionDB #D1FAE5

    Context -[#2E7D32]-> SessionDB : load / save
}


package "5. INPUT RESOLUTION AND CONTRACTS" as InputLayer {

    component "<b><color:#172033>BirthDataResolver</color></b>\n<color:#526071>BirthInput → ResolvedBirthData\nили единый InputRequired</color>" as BirthResolver #D9F9FF

    component "<b><color:#172033>PlaceResolverPort</color></b>\n<color:#526071>place_id / text\n→ canonical candidates</color>" as PlacePort #D9F9FF

    component "<b><color:#172033>LocalPlaceCatalogAdapter</color></b>\n<color:#526071>Локальный справочник мест,\nкоординат и tz_id</color>" as LocalPlace #D9F9FF

    component "<b><color:#172033>RemoteGeocoderAdapter</color></b>\n<color:#526071>Сетевой геокодинг,\ntimeout и cache</color>" as RemoteGeo #D9F9FF

    component "<b><color:#172033>Historical TZ Resolver</color></b>\n<color:#526071>tz_id + local datetime\n→ offset и UTC datetime</color>" as Timezone #D9F9FF

    component "<b><color:#172033>ActionContractBuilder</color></b>\n<color:#526071>topic + focus + active_view\n→ ContractDraft</color>" as ActionBuilder #F99999

    component "<b><color:#172033>ContractValidator</color></b>\n<color:#526071>Typed command / ContractDraft\n→ validated contract\nили единый InputRequired</color>" as ContractValidator #F99999

    BirthResolver -[#2563EB]-> PlacePort : resolve place
    BirthResolver -[#2563EB]-> Timezone : resolve historical time

    PlacePort -[#7E57C2,dashed]-> LocalPlace : adapter binding
    PlacePort -[#7E57C2,dashed]-> RemoteGeo : adapter binding
}


package "6. POLICY AND COST CONTROL" as PolicyLayer {

    component "<b><color:#172033>CapabilityService</color></b>\n<color:#9F1239>Session + deployment mode\n→ CapabilitySet</color>" as Capability #FCE7F3

    component "<b><color:#172033>PolicyService</color></b>\n<color:#9F1239>Operation + plan + capabilities\n→ permit или deny</color>" as Policy #FCE7F3

    component "<b><color:#172033>RateLimiter</color></b>\n<color:#9F1239>Transport precheck:\nIP / session / endpoint rate</color>" as RateLimiter #FCE7F3

    component "<b><color:#172033>InterpretationBudget</color></b>\n<color:#9F1239>Atomic reserve / commit / cancel\nдля preset interpretation</color>" as Budget #FCE7F3

    database "<b><color:#172033>Interpretation Budget Store</color></b>\n<color:#9F1239>Preset interpretation quota +\nglobal daily ceiling</color>" as BudgetDB #FCE7F3

    Budget -[#2E7D32]-> BudgetDB : atomic reserve / commit / cancel
}


package "7. PLANNING AND TOOL RUNTIME" as Runtime {

    component "<b><color:#172033>Planner</color></b>\n<color:#526071>ResolvedContract\n→ InterpretationPlan\nили единый InputRequired</color>" as Planner #FEF3C7

    component "<b><color:#172033>ScenarioRegistry</color></b>\n<color:#526071>required fields,\ntools[] и topics[]</color>" as ScenarioRegistry #FEF3C7

    component "<b><color:#172033>ToolExecutor</color></b>\n<color:#526071>Approved tools, timeout\nи лимит шагов</color>" as ToolExecutor #FEF3C7

    component "<b><color:#172033>ToolRegistry</color></b>\n<color:#526071>Реестр доступных tools</color>" as ToolRegistry #D9E997

    component "<b><color:#172033>Chart Tools</color></b>\n<color:#526071>ensure_natal_chart,\ntransit и solar</color>" as ChartTools #D9E997

    Planner -[#7E57C2,dashed]-> ScenarioRegistry : scenario lookup
    ToolExecutor -[#7E57C2,dashed]-> ToolRegistry : resolve tool
    ToolRegistry -[#7E57C2,dashed]-> ChartTools : adapter
    ToolExecutor -[#2563EB]-> ChartTools : ToolRequest
}


package "8. CHART ARTIFACTS AND CALCULATION PORT" as Artifacts {

    component "<b><color:#172033>ChartArtifactResolver</color></b>\n<color:#526071>Cache lookup или\nдетерминированный пересчёт</color>" as ArtifactResolver #E8F5E9

    component "<b><color:#172033>CalculationKeyFactory</color></b>\n<color:#526071>Resolved inputs + dependency keys\n+ ChartSpec + CalculationVersion\n→ calculation_key</color>" as KeyFactory #E8F5E9

    component "<b><color:#172033>CalculationVersionProvider</color></b>\n<color:#526071>Engine + swisseph +\nephemeris-data fingerprint</color>" as CalcVersion #E8F5E9

    database "<b><color:#172033>Calculation Cache</color></b>\n<color:#526071>Удаляемые и полностью\nвоспроизводимые ChartArtifacts</color>" as CalcCache #E8F5E9

    component "<b><color:#172033>CalculationEnginePort</color></b>\n<color:#526071>calculate_natal / transit / solar\nбез знания места исполнения</color>" as EnginePort #FFFFF0

    component "<b><color:#172033>LocalEngineAdapter</color></b>\n<color:#526071>Вызов ядра в процессе</color>" as LocalEngineAdapter #FFFFF0

    component "<b><color:#172033>RemoteEngineAdapter</color></b>\n<color:#526071>HTTP к Calculation Service</color>" as RemoteEngineAdapter #FFFFF0

    ArtifactResolver -[#7E57C2,dashed]-> KeyFactory : build key
    KeyFactory -[#7E57C2,dashed]-> CalcVersion : calculation version
    ArtifactResolver -[#2E7D32]-> CalcCache : get / put
    ArtifactResolver -[#2563EB]-> EnginePort : cache miss

    EnginePort -[#7E57C2,dashed]-> LocalEngineAdapter : adapter binding
    EnginePort -[#7E57C2,dashed]-> RemoteEngineAdapter : adapter binding
}


package "9. DETERMINISTIC CALCULATION ENGINE" as Calculation {

    component "<b><color:#172033>EngineService</color></b>\n<color:#526071>Application boundary\nдетерминированного ядра</color>" as Engine #FFFFF0

    component "<b><color:#172033>calculate_natal()</color></b>\n<color:#526071>Натал или космограмма</color>" as Natal #FFFFF0

    component "<b><color:#172033>calculate_transit()</color></b>\n<color:#526071>Транзитные позиции\nи аспекты</color>" as Transit #FFFFF0

    component "<b><color:#172033>calculate_solar_return()</color></b>\n<color:#526071>Соляр на год и место</color>" as Solar #FFFFF0

    component "<b><color:#172033>Ephemeris Core</color></b>\n<color:#526071>Тела, дома, углы,\nJulian Day</color>" as Ephemeris #FFFFF0

    component "<b><color:#172033>Domain Calculations</color></b>\n<color:#526071>Аспекты, конфигурации,\nсила и производные точки</color>" as Calculations #FFFFF0

    LocalEngineAdapter -[#2563EB]-> Engine : local call

    Engine -[#94A3B8]-> Natal
    Engine -[#94A3B8]-> Transit
    Engine -[#94A3B8]-> Solar

    Natal -[#2563EB]-> Ephemeris
    Transit -[#2563EB]-> Ephemeris
    Solar -[#2563EB]-> Ephemeris

    Natal -[#2563EB]-> Calculations
    Transit -[#2563EB]-> Calculations
    Solar -[#2563EB]-> Calculations
}


package "10. PRESET INTERPRETATION" as Interpretation {

    component "<b><color:#172033>InterpretationService</color></b>\n<color:#526071>Детерминированная сборка\nEvidence и одного PromptBundle</color>" as InterpretationService #F2D4CA

    component "<b><color:#172033>DataSelector</color></b>\n<color:#526071>InterpretationPlan + ToolResults\n→ Evidence</color>" as Selector #F2D4CA

    component "<b><color:#172033>PromptBuilder</color></b>\n<color:#526071>Evidence + preset recipe\n→ один PromptBundle</color>" as PromptBuilder #F2D4CA

    component "<b><color:#172033>PromptRegistry</color></b>\n<color:#526071>Рецепты по topic,\nfocus и mode</color>" as PromptRegistry #F2D4CA

    component "<b><color:#172033>PresetInterpretationKeyFactory</color></b>\n<color:#526071>Artifact keys + focus + recipe,\nprompt и model versions → key</color>" as PresetKeyFactory #E8F5E9

    database "<b><color:#172033>Preset Interpretation Cache</color></b>\n<color:#526071>Разделяемые ответы только\nдля preset-flow без chat context</color>" as PresetCache #E8F5E9

    component "<b><color:#172033>LLM Gateway</color></b>\n<color:#526071>Model profile, streaming,\ntimeout и token limit</color>" as Gateway #F2D4CA

    component "<b><color:#172033>OutputGuard</color></b>\n<color:#9F1239>Проверка ответа\nи безопасный Markdown</color>" as OutputGuard #FCE7F3

    InterpretationService -[#2563EB]-> Selector : plan + ToolResults
    Selector -[#00838F]-> InterpretationService : Evidence

    InterpretationService -[#2563EB]-> PromptBuilder : Evidence
    PromptBuilder -[#00838F]-> InterpretationService : PromptBundle
    PromptBuilder -[#7E57C2,dashed]-> PromptRegistry : preset recipe

    InterpretationService -[#7E57C2,dashed]-> PresetKeyFactory : build cache key
}


package "11. EXTERNAL AND PLATFORM" as External {

    component "<b><color:#172033>LLM Provider</color></b>\n<color:#526071>Генерация текста</color>" as LLM #E5E7EB

    component "<b><color:#172033>Swiss Ephemeris</color></b>\n<color:#526071>Астрономические эфемериды</color>" as Swiss #D1D5DB

    component "<b><color:#172033>Geocoding Provider</color></b>\n<color:#526071>Внешний каталог мест</color>" as GeoProvider #E5E7EB

    component "<b><color:#172033>Calculation Service</color></b>\n<color:#526071>Удалённое детерминированное\nрасчётное ядро</color>" as RemoteCalculationService #E5E7EB

    component "<b><color:#172033>Observability</color></b>\n<color:#526071>Redacted logs, metrics, tracing,\ntokens, policy и budget decisions</color>" as Obs #F1F5F9
}


' =========================================================
' ENTRY, SESSION AND TRANSPORT CONTROLS
' =========================================================

User -[#2563EB]-> Frontend
Frontend -[#2563EB]-> API

API -[#2563EB]-> SessionMiddleware : HttpOnly cookie
SessionMiddleware -[#00838F]-> API : session_id

API -[#C62828]-> RateLimiter : IP + session + endpoint
RateLimiter -[#00838F]-> API : RequestPermit / denied

BuildNatalAPI -[#2563EB]-> Orch : BuildNatalCommand
BuildDerivedAPI -[#2563EB]-> Orch : BuildDerivedChartCommand
SetViewAPI -[#2563EB]-> Orch : SetActiveViewCommand
SelectionAPI -[#2563EB]-> Orch : SelectionCommand

Orch -[#2E7D32]-> Context : load / save ContextDelta
Context -[#00838F]-> Orch : SessionContext

Orch -[#C62828]-> Capability : session + deployment mode
Capability -[#00838F]-> Orch : CapabilitySet


' =========================================================
' EXPLICIT BASE-CHART MUTATION
' =========================================================

Orch -[#2563EB]-> BuildNatalHandler : command + SessionContext

BuildNatalHandler -[#2563EB]-> BirthResolver : BirthInput
BirthResolver -[#00838F]-> BuildNatalHandler : ResolvedBirthData / InputRequired

BuildNatalHandler -[#2563EB]-> ArtifactResolver : birth_resolved + base ChartSpec
ArtifactResolver -[#00838F]-> BuildNatalHandler : ChartArtifact

BuildNatalHandler -[#2563EB]-> Profile : commit_base_chart(\nexpected_version, birth_input,\nbirth_resolved, spec)
Profile -[#00838F]-> BuildNatalHandler : SessionProfileDelta

BuildNatalHandler -[#00838F]-> Orch : BuildResult + ContextDelta\n/ InputRequired


' =========================================================
' EXPLICIT DERIVED-CHART MUTATION
' =========================================================

Orch -[#2563EB]-> BuildDerivedHandler : command + SessionProfile

BuildDerivedHandler -[#2563EB]-> ContractValidator : BuildDerivedChartCommand\n+ SessionProfile
ContractValidator -[#00838F]-> BuildDerivedHandler : ResolvedDerivedCommand\n/ InputRequired

BuildDerivedHandler -[#2563EB]-> ArtifactResolver : birth_resolved\n+ derived ChartSpec
ArtifactResolver -[#00838F]-> BuildDerivedHandler : ChartArtifact

BuildDerivedHandler -[#2563EB]-> Profile : commit_derived_chart(\nexpected_version, spec)\nactive_view unchanged
Profile -[#00838F]-> BuildDerivedHandler : SessionProfileDelta

BuildDerivedHandler -[#00838F]-> Orch : BuildResult + ContextDelta\n/ InputRequired


' =========================================================
' EXPLICIT ACTIVE-VIEW MUTATION
' =========================================================

Orch -[#2563EB]-> SetViewHandler : command + SessionProfile

SetViewHandler -[#2563EB]-> ContractValidator : requested view\n+ SessionProfile
ContractValidator -[#00838F]-> SetViewHandler : ValidatedViewCommand\n/ InputRequired

SetViewHandler -[#2563EB]-> Profile : set_active_view(\nexpected_version, base | derived)
Profile -[#00838F]-> SetViewHandler : SessionProfileDelta

SetViewHandler -[#00838F]-> Orch : ViewResult + ContextDelta\n/ InputRequired


' =========================================================
' PRESET SELECTION FLOW — READ-ONLY SESSION PROFILE
' =========================================================

Orch -[#2563EB]-> SelectionHandler : command + SessionProfile

SelectionHandler -[#2563EB]-> ActionBuilder : topic + focus + active_view
ActionBuilder -[#00838F]-> SelectionHandler : ContractDraft

SelectionHandler -[#2563EB]-> ContractValidator : ContractDraft + SessionProfile
ContractValidator -[#00838F]-> SelectionHandler : ResolvedContract / InputRequired

SelectionHandler -[#00838F]-> Orch : PreparedSelectionRequest\n/ InputRequired


' =========================================================
' PLANNING, POLICY AND TOOL EXECUTION
' =========================================================

Orch -[#2563EB]-> Planner : ResolvedContract
Planner -[#00838F]-> Orch : InterpretationPlan / InputRequired

Orch -[#C62828]-> Policy : preset operation + plan\n+ CapabilitySet
Policy -[#00838F]-> Orch : AuthorizedPlan / PolicyDenied

Orch -[#2563EB]-> ToolExecutor : AuthorizedPlan

ChartTools -[#2563EB]-> ArtifactResolver : resolved inputs + ChartSpec
ArtifactResolver -[#00838F]-> ChartTools : ChartArtifact
ChartTools -[#00838F]-> ToolExecutor : ToolResult

ToolExecutor -[#00838F]-> Orch : ToolResults


' =========================================================
' PRESET INTERPRETATION, CACHE AND BUDGET
' =========================================================

Orch -[#2563EB]-> InterpretationService : InterpretationPlan + ToolResults
InterpretationService -[#00838F]-> Orch : PreparedPresetPrompt\n+ PresetInterpretationKey

Orch -[#2E7D32]-> PresetCache : get
PresetCache -[#00838F]-> Orch : cached safe response / miss

Orch -[#C62828]-> Budget : reserve preset_interpretation\n[only on cache miss]
Budget -[#00838F]-> Orch : BudgetPermit / BudgetDenied

Orch -[#2563EB]-> Gateway : PromptBundle + BudgetPermit
Gateway -[#EF6C00]-> LLM
LLM -[#00838F]-> Gateway : token stream

Gateway -[#C62828]-> OutputGuard : generated chunks
OutputGuard -[#00838F]-> Orch : safe chunks

Orch -[#2E7D32]-> PresetCache : put safe response
Orch -[#C62828]-> Budget : commit / cancel actual usage


' =========================================================
' RESPONSE
' =========================================================

Orch -[#00838F]-> API : JSON / SSE\ninput_required / token / done / error
API -[#00838F]-> Frontend

Frontend -[#2563EB]-> LocationUI : candidates
LocationUI -[#00838F]-> Frontend : selected place_id

Frontend -[#2563EB]-> Renderer : ChartResponse


' =========================================================
' EXTERNAL ADAPTERS
' =========================================================

RemoteGeo -[#EF6C00]-> GeoProvider
RemoteEngineAdapter -[#EF6C00]-> RemoteCalculationService
Ephemeris -[#EF6C00]-> Swiss


' =========================================================
' OBSERVABILITY
' =========================================================

API -[#64748B,dashed]-> Obs
Orch -[#64748B,dashed]-> Obs
RateLimiter -[#64748B,dashed]-> Obs : rate decision
Capability -[#64748B,dashed]-> Obs : capability decision
Policy -[#64748B,dashed]-> Obs : policy decision
Budget -[#64748B,dashed]-> Obs : quota / budget decision
ToolExecutor -[#64748B,dashed]-> Obs
Gateway -[#64748B,dashed]-> Obs : token / latency metadata
OutputGuard -[#64748B,dashed]-> Obs : guard decision


' =========================================================
' NOTES
' =========================================================

note right of SessionDB
<b><color:#172033>SessionProfile</color></b>
<color:#526071>{</color>
<color:#526071>  birth_input: BirthInput</color>
<color:#526071>  birth_resolved: ResolvedBirthData</color>
<color:#526071>  profile_version: int</color>
<color:#526071>  base_chart:</color>
<color:#526071>    { profile_version, spec }</color>
<color:#526071>  derived_chart:</color>
<color:#526071>    { profile_version, spec } | None</color>
<color:#526071>  active_view: base | derived</color>
<color:#526071>}</color>

<color:#526071>birth_input нужен для формы.</color>
<color:#526071>birth_resolved — стабильный источник</color>
<color:#526071>расчёта и calculation key.</color>
end note


note right of BuildNatalHandler
<color:#526071>Успешная явная замена birth data:</color>
<color:#526071>• увеличивает profile_version;</color>
<color:#526071>• заменяет base_chart;</color>
<color:#526071>• сбрасывает derived_chart;</color>
<color:#526071>• устанавливает active_view = base.</color>
end note


note right of BuildDerivedHandler
<color:#526071>Команда создаёт или заменяет</color>
<color:#526071>только derived_chart.</color>

<b><color:#172033>active_view не меняется.</color></b>
<color:#526071>Для переключения существует</color>
<color:#526071>отдельный SetActiveViewCommand.</color>
end note


note right of Profile
<color:#526071>ProfileService не имеет своей БД.</color>
<color:#526071>Persistence выполняет ContextService.</color>

<b><color:#172033>Только три явных handler'а</color></b>
<color:#526071>могут менять SessionProfile:</color>
<color:#526071>BuildNatal, BuildDerivedChart,</color>
<color:#526071>SetActiveView.</color>

<color:#526071>Orchestrator и SelectionHandler</color>
<b><color:#172033>профиль не мутируют.</color></b>
end note


note right of ContractValidator
<b><color:#172033>Единый InputRequired</color></b>
<color:#526071>{ issues: [{</color>
<color:#526071>  field: contract.path,</color>
<color:#526071>  code: MISSING | AMBIGUOUS |</color>
<color:#526071>        INVALID | UNSUPPORTED,</color>
<color:#526071>  candidates?, constraints?</color>
<color:#526071>}] }</color>

<color:#526071>Тот же тип возвращают Resolver,</color>
<color:#526071>Validator и Planner; каждый исход</color>
<color:#526071>поднимается через вызвавший handler.</color>
end note


note right of KeyFactory
<b><color:#172033>CalculationVersion</color></b>
<color:#526071>включает:</color>
<color:#526071>• engine version;</color>
<color:#526071>• swisseph library version;</color>
<color:#526071>• ephe/*.se1 fingerprint.</color>

<color:#526071>Обновление любой части создаёт</color>
<color:#526071>новый calculation key.</color>
end note


note right of EnginePort
<color:#526071>Local / remote скрывается здесь,</color>
<color:#526071>а не на уровне Tool.</color>

<color:#526071>ChartArtifactResolver и cache</color>
<color:#526071>остаются в вызывающем приложении.</color>
<color:#526071>Удалённый Calculation Service</color>
<color:#526071>остаётся stateless.</color>
end note


note right of PresetCache
<color:#526071>Это настоящий разделяемый cache:</color>
<color:#526071>preset prompt не содержит raw text</color>
<color:#526071>или истории конкретной сессии.</color>

<color:#526071>Free-form replay guard относится</color>
<b><color:#172033>к отдельной post-MVP NL-схеме.</color></b>
end note


note right of Budget
<color:#526071>RateLimiter работает на API.</color>
<color:#526071>InterpretationBudget вызывается</color>
<color:#526071>в общем interpretation-flow только</color>
<color:#526071>после cache miss.</color>

<color:#526071>Для SelectionCommand класс операции:</color>
<b><color:#172033>preset_interpretation.</color></b>

<b><color:#172033>Global daily ceiling обязателен.</color></b>
end note


note right of Obs
<b><color:#172033>REQUIRED INVARIANT</color></b>

