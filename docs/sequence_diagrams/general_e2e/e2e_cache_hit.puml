@startuml
title exact-orb — E2E: попадание в Calculation Cache (натальная карта)

autonumber
skinparam shadowing false
skinparam ParticipantPadding 12
skinparam BoxPadding 12
skinparam DefaultFontSize 12

actor "Пользователь" as User

box "КАНАЛ" #E3F2FD
  boundary "API Gateway\nSSE" as Entry
end box

box "РЕШЕНИЕ И КООРДИНАЦИЯ" #E8F5E9
  control "Orchestrator" as Orch
  control "Planner" as Planner
  database "ScenarioRegistry" as ScenReg
end box

box "ПОНИМАНИЕ ЗАПРОСА" #FFF3E0
  control "IntentService\n(фасад)" as Intent
end box

box "ИНСТРУМЕНТЫ" #E8F5E9
  database "ToolRegistry" as ToolReg
  control "NatalTool" as NatalTool
end box

box "РАСЧЁТ" #E8F5E9
  control "EngineService\nget_natal()" as Engine
end box

box "ИЗЛОЖЕНИЕ" #E8F5E9
  control "DataSelector" as Selector
  control "PromptBuilder" as PBuilder
end box

box "LLM" #FFF3E0
  control "LLM Gateway" as Gateway
  participant "Провайдер" as Provider
end box

box "СОСТОЯНИЕ" #ECEFF1
  database "ContextService" as Ctx
  database "Calculation Cache" as Cache
  database "Journal" as Journal
end box

User -> Entry : «Расскажи о моей натальной карте ещё раз.\nРодилась 2 сентября 1990, 14:30, Москва»
activate Entry

Entry -> Entry : лимиты, квота,\nдедупликация
Entry -> Orch : handle(session_id, conversation_id, text)
activate Orch
Entry --> User : открыт поток SSE

== Контекст и понимание запроса ==
Orch -> Ctx : load(conversation_id)
activate Ctx
Ctx --> Orch : контекст пуст,\npending нет
deactivate Ctx

Orch ->> Entry : event: status\n«разбираю запрос»
Entry ->> User : status

Orch -> Intent : understand(text, context)
activate Intent
Intent --> Orch : ResolvedContract\nutc = 10:30, lat/lon, tz_id,\ntime_assumed=false, focus=[]
deactivate Intent

note over Orch, Intent
  Экстрактор и резолвер разбирают текст заново —
  они не знают про кэш и не обязаны знать.
  Дата, время и место совпадают с уже посчитанной
  картой, а значит совпадёт и хэш параметров ниже.
end note

== Планирование ==
Orch -> Planner : plan(contract)
activate Planner
Planner -> ScenReg : get("natal")
activate ScenReg
ScenReg --> Planner : tools=[natal]\ntopics=[natal, recipe=natal.general, mode=full]
deactivate ScenReg
Planner --> Orch : InterpretationPlan\nmissing_slots=[]
deactivate Planner

Orch ->> Entry : event: status «считаю карту»
Entry ->> User : status

== Расчёт: попадание в кэш ==
Orch -> ToolReg : get("natal")
activate ToolReg
ToolReg --> Orch : адаптер по конфигурации
deactivate ToolReg

Orch -> NatalTool : run(ToolRequest)
activate NatalTool
NatalTool -> Cache : lookup(хэш параметров)
activate Cache
Cache --> NatalTool : попадание —\nготовый NatalChart
deactivate Cache

note right of NatalTool
  EngineService не вызывается вовсе.
  Расчёт — самая тяжёлая деталь запроса
  (эфемериды, дома, аспекты, конфигурации,
  сила), и его пропуск — единственная причина,
  ради которой кэш карт нужен (ADR-0013):
  повторный расчёт «того же самого» не должен
  повторно грузить движок.
end note

NatalTool --> Orch : ToolResult(data, warnings=[],\nmeta: cache_hit=true)
deactivate NatalTool

== Изложение ==
Orch ->> Entry : event: status «готовлю разбор»
Orch -> Selector : select(plan, tool_results)
activate Selector
Selector --> Orch : Evidence по темам
deactivate Selector

Orch -> PBuilder : build(plan, evidence)
activate PBuilder
PBuilder --> Orch : PromptBundle
deactivate PBuilder

== Поток от модели ==
Orch -> Gateway : complete_stream(bundle,\nпрофиль «интерпретация», max_tokens)
activate Gateway
Gateway -> Provider : chat completion, stream
activate Provider

loop пока идут куски
  Provider -->> Gateway : chunk
  Gateway -->> Orch : chunk
  Orch -> Orch : накопить текст
  Orch ->> Entry : event: token
  Entry ->> User : token
end

Provider --> Gateway : конец потока
Gateway --> Orch : usage, латентность
Orch ->> Entry : event: done
deactivate Provider
deactivate Gateway

== Финализация ==
Orch -> Ctx : save(delta)
Orch ->> Journal : Analytics(status=ok, cache_hit=true)\n+ History
deactivate Orch
Entry --> User : поток закрыт
deactivate Entry

note over Orch, Journal
  LLM всё равно вызывается — кэшируется расчёт
  карты, а не интерпретация (это два разных кэша
  в ADR-0013: кэш расчётов и отдельно обсуждаемый
  кэш интерпретаций). Экономия здесь — задержка
  ответа и нагрузка на EngineService, а не токены
  модели.
end note

@enduml
